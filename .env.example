# ============================================================
# Grace Fellowship Church - Environment Configuration
# ============================================================

# --- Server Settings ---
HOST=0.0.0.0
PORT=8000
DEBUG=false

# --- PostgreSQL Database Settings ---
# Option A: Full Connection String (Recommended for Render, Supabase, Neon, AWS RDS)
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/church_db

# Option B: Individual Parameters (Used if DATABASE_URL is not set)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DB=church_db
POSTGRES_SSLMODE=prefer

# --- Pastoral Admin Authentication ---
ADMIN_USERNAME=pastor
ADMIN_PASSWORD=GraceChurch2026!
ADMIN_JWT_SECRET=grace-church-pastoral-jwt-secret-key-2026
ADMIN_TOKEN_EXPIRE_MINUTES=1440

# --- File Storage Limits ---
# Maximum total attachment size per prayer submission (in bytes; 104857600 = 100 MB)
MAX_ATTACHMENT_SIZE_BYTES=104857600
